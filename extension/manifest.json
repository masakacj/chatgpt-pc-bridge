{
  "manifest_version": 3,
  "name": "ChatGPT PC Bridge (Development)",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Standalone local bridge, native conversation state and mobile companion. Not a production migration yet.",
  "permissions": ["tabs", "storage", "alarms", "scripting", "webRequest"],
  "host_permissions": ["https://chatgpt.com/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["pc-resilience-content.js"], "run_at": "document_idle"}],
  "options_page": "options.html",
  "action": {"default_title": "ChatGPT PC Bridge"}
}
