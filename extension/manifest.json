{
  "manifest_version": 3,
  "name": "ChatGPT PC Bridge",
  "version": "0.2.3",
  "minimum_chrome_version": "120",
  "description": "Native phone companion for a shared ChatGPT Chrome tab. Independent from the Orchestrator executor.",
  "permissions": ["tabs", "storage", "alarms", "scripting", "webRequest"],
  "host_permissions": ["https://chatgpt.com/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "options_page": "options.html",
  "action": {"default_title": "ChatGPT PC Bridge"}
}
